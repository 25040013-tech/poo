#include <iostream>
#include <string>

using namespace std;

int main() {
    
    const int MAX_ALUMNOS = 10;

    
    string nombres[MAX_ALUMNOS];
    int edades[MAX_ALUMNOS];
    double promedios[MAX_ALUMNOS];

    
    int opcion = 0;
    int cantidadRegistrada = 0; 

    
    do {
        cout << "\n=================================\n";
        cout << "   GESTION DE ALUMNOS (MAX " << MAX_ALUMNOS << ")\n";
        cout << "=================================\n";
        cout << "1. Registrar alumnos\n";
        cout << "2. Mostrar todos los alumnos\n";
        cout << "3. Salir\n";
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {
            case 1: {
                if (cantidadRegistrada >= MAX_ALUMNOS) {
                    cout << "\n[!] Ya se ha alcanzado el limite de " << MAX_ALUMNOS << " alumnos.\n";
                } else {
                    cout << "\n--- REGISTRO DE ALUMNOS ---\n";
                    
                    for (int i = cantidadRegistrada; i < MAX_ALUMNOS; i++) {
                        cout << "\nAlumno #" << (i + 1) << ":\n";
                        
                        cout << "Nombre: ";
                        cin.ignore(); 
                        getline(cin, nombres[i]);

                        cout << "Edad: ";
                        cin >> edades[i];

                        cout << "Promedio: ";
                        cin >> promedios[i];

                        cantidadRegistrada++; 

                        char continuar;
                        if (i < MAX_ALUMNOS - 1) {
                            cout << "¿Desea registrar otro alumno ahora? (s/n): ";
                            cin >> continuar;
                            if (continuar == 'n' || continuar == 'N') {
                                break; 
                            }
                        }
                    }
                }
                break;
            }
            case 2: {
                cout << "\n--- LISTA DE ALUMNOS REGISTRADOS ---\n";
                if (cantidadRegistrada == 0) {
                    cout << "No hay alumnos registrados aun.\n";
                } else {
                    
                    for (int i = 0; i < cantidadRegistrada; i++) {
                        cout << i + 1 << ". Nombre: " << nombres[i]
                             << " | Edad: " << edades[i]
                             << " | Promedio: " << promedios[i] << endl;
                    }
                }
                break;
            }
            case 3:
                cout << "\nSaliendo del programa...\n";
                break;

            default:
                cout << "\n[!] Opcion no valida. Intente de nuevo.\n";
                break;
        }

    } while (opcion != 3);

    return 0;
}

