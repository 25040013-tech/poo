#include <iostream>
#include <string>

using namespace std;

const int MAX = 100;
string nombres[MAX];
int edades[MAX];
double promedios[MAX];
int cantidad = 0;

int buscarAlumno(string nombre);
void registrarAlumno();
void mostrarAlumno();
void mostrarAlumnoPorNombre();
void eliminarAlumno();
void modificarAlumno();
void mostrarTodos();
void calcularPromedio();
void menu();

int main() {
    menu();
    return 0;
}

int buscarAlumno(string nombre) {
    for (int i = 0; i < cantidad; i++) {
        if (nombres[i] == nombre) {
            return i;
        }
    }
    return -1;
}

void registrarAlumno() {
    if (cantidad >= MAX) {
        cout << "\n[ERROR] El sistema ha alcanzado el límite máximo de alumnos (" << MAX << ").\n";
        return;
    }

    cout << "\n--- REGISTRAR ALUMNO ---" << endl;
    cout << "Ingrese el nombre del alumno: ";
    cin.ignore();
    getline(cin, nombres[cantidad]);

    cout << "Ingrese la edad: ";
    cin >> edades[cantidad];

    cout << "Ingrese el promedio general: ";
    cin >> promedios[cantidad];

    cantidad++;
    cout << "-> ¡Alumno registrado con éxito!\n";
}

void mostrarAlumno() {
    if (cantidad == 0) {
        cout << "\n[AVISO] No hay alumnos registrados todavía.\n";
        return;
    }

    int pos;
    cout << "\n--- MOSTRAR ALUMNO POR ÍNDICE ---" << endl;
    cout << "Ingrese el índice del alumno (0 a " << cantidad - 1 << "): ";
    cin >> pos;

    if (pos >= 0 && pos < cantidad) {
        cout << "\nDatos del alumno [" << pos << "]:\n";
        cout << "  Nombre:   " << nombres[pos] << endl;
        cout << "  Edad:     " << edades[pos] << " años" << endl;
        cout << "  Promedio: " << promedios[pos] << endl;
    } else {
        cout << "[ERROR] Índice fuera de rango válido.\n";
    }
}

void mostrarAlumnoPorNombre() {
    if (cantidad == 0) {
        cout << "\n[AVISO] No hay alumnos registrados para buscar.\n";
        return;
    }

    string nombreBuscado;
    cout << "\n--- BUSCAR ALUMNO POR NOMBRE ---" << endl;
    cout << "Ingrese el nombre exacto a buscar: ";
    cin.ignore();
    getline(cin, nombreBuscado);

    int pos = buscarAlumno(nombreBuscado);

    if (pos != -1) {
        cout << "\n¡Alumno encontrado en la posición [" << pos << "]!\n";
        cout << "  Nombre:   " << nombres[pos] << endl;
        cout << "  Edad:     " << edades[pos] << " años" << endl;
        cout << "  Promedio: " << promedios[pos] << endl;
    } else {
        cout << "[AVISO] No se encontró a ningún alumno con el nombre: " << nombreBuscado << endl;
    }
}

void eliminarAlumno() {
    if (cantidad == 0) {
        cout << "\n[AVISO] No hay alumnos registrados para eliminar.\n";
        return;
    }

    string nombreEliminar;
    cout << "\n--- ELIMINAR ALUMNO ---" << endl;
    cout << "Ingrese el nombre del alumno a eliminar: ";
    cin.ignore();
    getline(cin, nombreEliminar);

    int pos = buscarAlumno(nombreEliminar);

    if (pos != -1) {
        for (int i = pos; i < cantidad - 1; i++) {
            nombres[i] = nombres[i + 1];
            edades[i] = edades[i + 1];
            promedios[i] = promedios[i + 1];
        }
        cantidad--;
        cout << "-> ¡Alumno '" << nombreEliminar << "' eliminado correctamente!\n";
    } else {
        cout << "[ERROR] No se pudo eliminar. El alumno no fue encontrado.\n";
    }
}

void modificarAlumno() {
    if (cantidad == 0) {
        cout << "\n[AVISO] No hay alumnos registrados para modificar.\n";
        return;
    }

    string nombreModificar;
    cout << "\n--- MODIFICAR ALUMNO ---" << endl;
    cout << "Ingrese el nombre del alumno a modificar: ";
    cin.ignore();
    getline(cin, nombreModificar);

    int pos = buscarAlumno(nombreModificar);

    if (pos != -1) {
        cout << "\n--- Ingrese los NUEVOS datos del alumno ---" << endl;
        cout << "Nuevo Nombre: ";
        getline(cin, nombres[pos]);

        cout << "Nueva Edad: ";
        cin >> edades[pos];

        cout << "Nuevo Promedio: ";
        cin >> promedios[pos];

        cout << "-> ¡Datos del alumno modificados con éxito!\n";
    } else {
        cout << "[ERROR] No se pudo modificar. El alumno no fue encontrado.\n";
    }
}

void mostrarTodos() {
    if (cantidad == 0) {
        cout << "\n[AVISO] No hay alumnos registrados para mostrar.\n";
        return;
    }

    cout << "\n--- LISTA DE TODOS LOS ALUMNOS ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << "Índice [" << i << "] | Nombre: " << nombres[i] 
             << " | Edad: " << edades[i] 
             << " | Promedio: " << promedios[i] << endl;
    }
}

void calcularPromedio() {
    double cal1, cal2, cal3;
    cout << "\n--- CALCULAR PROMEDIO DE NOTAS ---" << endl;
    cout << "Ingrese la primera calificación: ";
    cin >> cal1;
    cout << "Ingrese la segunda calificación: ";
    cin >> cal2;
    cout << "Ingrese la tercera calificación: ";
    cin >> cal3;

    double promedioCalculado = (cal1 + cal2 + cal3) / 3.0;
    cout << "-> El promedio calculado es: " << promedioCalculado << endl;
}

void menu() {
    int opcion;
    do {
        cout << "\n=================================" << endl;
        cout << "        MENÚ DE OPCIONES         " << endl;
        cout << "=================================" << endl;
        cout << "1. Registrar alumno" << endl;
        cout << "2. Mostrar alumno por índice" << endl;
        cout << "3. Buscar alumno por nombre" << endl;
        cout << "4. Modificar alumno" << endl;
        cout << "5. Eliminar alumno" << endl;
        cout << "6. Mostrar todos los alumnos" << endl;
        cout << "7. Calcular promedio de 3 notas" << endl;
        cout << "8. Salir" << endl;
        cout << "Seleccione una opción: ";
        cin >> opcion;

        switch (opcion) {
            case 1:
                registrarAlumno();
                break;
            case 2:
                mostrarAlumno();
                break;
            case 3:
                mostrarAlumnoPorNombre();
                break;
            case 4:
                modificarAlumno();
                break;
            case 5:
                eliminarAlumno();
                break;
            case 6:
                mostrarTodos();
                break;
            case 7:
                calcularPromedio();
                break;
            case 8:
                cout << "\nSaliendo del programa... ¡Hasta luego!\n";
                break;
            default:
                cout << "\n[ERROR] Opción no válida. Intente de nuevo.\n";
                break;
        }
    } while (opcion != 8);
}


