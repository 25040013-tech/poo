#include <iostream>
#include <string>
#include <limits>

using namespace std;

class Alumno {
public:
    string nombre;
    int edad;
    float promedio;

    Alumno() {
        nombre = "";
        edad = 0;
        promedio = 0.0;
    }

    void capturar() {
        cout << "Ingrese el nombre: ";
        getline(cin, nombre);
        cout << "Ingrese la edad: ";
        cin >> edad;
        cout << "Ingrese el promedio: ";
        cin >> promedio;
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    void mostrar() const {
        cout << "Nombre: " << nombre 
             << " | Edad: " << edad 
             << " | Promedio: " << promedio << endl;
    }
};

void mostrarTodos(const Alumno alumnos[], int cantidad) {
    if (cantidad == 0) {
        cout << "No hay alumnos registrados.\n";
        return;
    }
    cout << "\n--- LISTA DE ALUMNOS ---\n";
    for (int i = 0; i < cantidad; i++) {
        cout << i + 1 << ". ";
        alumnos[i].mostrar();
    }
}

void intercambiar(Alumno &a, Alumno &b) {
    Alumno temp = a;
    a = b;
    b = temp;
}

int buscarPorNombre(const Alumno alumnos[], int cantidad, const string &nombreBuscado) {
    for (int i = 0; i < cantidad; i++) {
        if (alumnos[i].nombre == nombreBuscado) {
            return i;
        }
    }
    return -1;
}

bool eliminarAlumno(Alumno alumnos[], int &cantidad, int indice) {
    if (indice < 0 || indice >= cantidad) {
        return false;
    }
    for (int i = indice; i < cantidad - 1; i++) {
        alumnos[i] = alumnos[i + 1];
    }
    cantidad--;
    return true;
}

int main() {
    Alumno alumnos[100];
    int cantidad = 0;
    int opcion;

    do {
        cout << "\n=== MENU DE GESTION DE ALUMNOS ===\n";
        cout << "1. Agregar Alumno\n";
        cout << "2. Mostrar Todos los Alumnos\n";
        cout << "3. Buscar Alumno por Nombre\n";
        cout << "4. Eliminar Alumno\n";
        cout << "5. Intercambiar dos Alumnos (Posiciones)\n";
        cout << "6. Salir\n";
        cout << "Seleccione una opcion: ";
        cin >> opcion;
        cin.ignore(numeric_limits<streamsize>::max(), '\n');

        switch (opcion) {
            case 1:
                if (cantidad < 100) {
                    cout << "\n--- Datos del Alumno " << cantidad + 1 << " ---\n";
                    alumnos[cantidad].capturar();
                    cantidad++;
                    cout << "Alumno registrado con exito.\n";
                } else {
                    cout << "El arreglo esta lleno.\n";
                }
                break;

            case 2:
                mostrarTodos(alumnos, cantidad);
                break;

            case 3: {
                string busqueda;
                cout << "Ingrese el nombre a buscar: ";
                getline(cin, busqueda);
                int pos = buscarPorNombre(alumnos, cantidad, busqueda);
                if (pos != -1) {
                    cout << "Alumno encontrado en la posicion " << pos + 1 << ":\n";
                    alumnos[pos].mostrar();
                } else {
                    cout << "Alumno no encontrado.\n";
                }
                break;
            }

            case 4: {
                int pos;
                cout << "Ingrese la posicion del alumno a eliminar (1 a " << cantidad << "): ";
                cin >> pos;
                if (eliminarAlumno(alumnos, cantidad, pos - 1)) {
                    cout << "Alumno eliminado exitosamente.\n";
                } else {
                    cout << "Posicion invalida.\n";
                }
                break;
            }

            case 5: {
                int pos1, pos2;
                cout << "Ingrese la posicion del primer alumno (1 a " << cantidad << "): ";
                cin >> pos1;
                cout << "Ingrese la posicion del segundo alumno (1 a " << cantidad << "): ";
                cin >> pos2;
                if (pos1 > 0 && pos1 <= cantidad && pos2 > 0 && pos2 <= cantidad) {
                    intercambiar(alumnos[pos1 - 1], alumnos[pos2 - 1]);
                    cout << "Alumnos intercambiados con exito.\n";
                } else {
                    cout << "Posiciones invalidas.\n";
                }
                break;
            }

            case 6:
                cout << "Saliendo del programa...\n";
                break;

            default:
                cout << "Opcion no valida. Intente de nuevo.\n";
        }
    } while (opcion != 6);

    return 0;
}


